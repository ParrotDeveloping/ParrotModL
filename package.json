{
  "name": "parrotmodl",
  "productName": "ParrotModL",
  "version": "1.0.2",
  "description": "ParrotModL - Modern Minecraft mod launcher (Modrinth & CurseForge)",
  "main": "src/main/main.js",
  "author": {
    "name": "ParrotModL",
    "email": "support@parrotmodl.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "dist:dir": "electron-builder --win --dir --x64",
    "postinstall": "echo skip"
  },
  "dependencies": {
    "adm-zip": "0.5.16",
    "extract-zip": "2.0.1"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.16.1"
  },
  "build": {
    "appId": "app.parrotmodl.launcher",
    "productName": "ParrotModL",
    "copyright": "Copyright © 2026 ParrotModL",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asar": true,
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ParrotModL-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ParrotModL",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "language": "1055"
    }
  }
}
